#For the command line, `print` is used and You can use "" or '' 
print('hello world!') 
print("hello world!")

# Printing to the screen
print("Hello, Python!")

# Correct Indentation Example:
if 5 > 2:
    print("Five is greater than two!")  # Shifted right by 4 spaces

# Strict Rule: You must use the same number of spaces within the same block!
if 5 > 2:
    print("Line 1 of the block")
    print("Line 2 of the block")  # Matches the indentation above

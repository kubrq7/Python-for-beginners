# ==========================================
# 2. PYTHON VARIABLES (QUICK INTRODUCTION)
# ==========================================
# - In Python, a variable is automatically created the moment you assign a value to it.
# - You use the single equals sign (=) to create them.

x = 5
y = "Hello, World!"
print(x, y)  # Displays the values stored inside x and y

# ==========================================
# 3. ADVANCED PRINT() METHODS & OUTPUTS
# ==========================================

# A) Using the `end` Parameter
# - By default, print() automatically jumps to a new line at the end.
# - You can change this behavior using `end=" "`. This prints things on the SAME line.
print("Hello", end=" ")
print("World!")  # Output: Hello World!
